# Postgres — the host is the docker-compose service name, resolved on the
# compose network (the API runs inside that network).
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB_NAME=bingo
POSTGRES_USER=bingo_server
POSTGRES_PASSWORD=password
POSTGRES_SSL=false

# ";"-separated origin allowlists. The frontend must be served from one of these,
# and a login redirectUrl's origin must appear in ALLOWED_REDIRECT_ORIGINS.
ALLOWED_CORS_ORIGINS=localhost:5173
ALLOWED_REDIRECT_ORIGINS=http://localhost:5173

# "true" in production — sets the Secure flag on the session cookie.
SERVER_SECURE=false

# "mock" returns a constant string (fine for UI work); "anthropic" calls the API.
AI_DRIVER=mock

# Only required when AI_DRIVER=anthropic.
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
