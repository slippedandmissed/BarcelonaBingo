{
  "name": "@barcelona-bingo/backend",
  "private": true,
  "type": "module",
  "module": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev:compose": "MY_UID=$(id -u) MY_GID=$(id -g) docker compose",
    "dev:up": "bun run dev:compose up -d",
    "dev:down": "bun run dev:compose down",
    "dev:tail": "bun run dev:compose logs -f bingo_server",
    "lint": "oxlint",
    "fmt": "oxfmt --config ../.oxfmtrc.json --write .",
    "typecheck": "tsc --noEmit",
    "db:migrate": "bun run dev:compose run --rm -it bingo_server run ./node_modules/.bin/drizzle-kit migrate",
    "db:generate": "bun run dev:compose run --rm -it bingo_server run ./node_modules/.bin/drizzle-kit generate"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.124.0",
    "@elysiajs/cors": "^1.4.2",
    "drizzle-orm": "^0.45.2",
    "elysia": "^1.4.30",
    "mustache": "^4.2.0",
    "pg": "^8.23.0",
    "postgres": "^3.4.9",
    "typebox": "^1.3.27"
  },
  "devDependencies": {
    "@types/bun": "^1.4.1",
    "@types/mustache": "^4.2.6",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.23.13",
    "typescript": "~6.0.2"
  },
  "peerDependencies": {
    "typescript": "~6.0.2"
  }
}
