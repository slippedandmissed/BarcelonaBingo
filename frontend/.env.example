# Where Vite proxies /api during `bun run dev` — the nginx container from
# backend/docker-compose.yml.
PROXY_SERVER_TARGET=http://barcelona-bingo.localhost:1234

# Optional. API base URL the app uses at runtime; defaults to
# window.location.origin (correct in dev thanks to the proxy above). Set it for
# production if the API lives on a different origin.
# VITE_SERVER_URL=https://api.example.com
